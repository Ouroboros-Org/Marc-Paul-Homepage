# Google Forms custom-form endpoint. Replace YOUR_FORM_ID and each entry ID with
# values from the form's pre-filled link. See README.md for the matching questions.
NEXT_PUBLIC_GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse
NEXT_PUBLIC_GOOGLE_FORM_NAME_FIELD=entry.000000001
NEXT_PUBLIC_GOOGLE_FORM_EMAIL_FIELD=entry.000000002
NEXT_PUBLIC_GOOGLE_FORM_ORGANISATION_FIELD=entry.000000003
NEXT_PUBLIC_GOOGLE_FORM_AREA_FIELD=entry.000000004
NEXT_PUBLIC_GOOGLE_FORM_MESSAGE_FIELD=entry.000000005
NEXT_PUBLIC_GOOGLE_FORM_TIMING_FIELD=entry.000000006
